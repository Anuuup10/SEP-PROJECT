PORT=5000
GEMINI_API_KEY=replace_with_your_gemini_api_key
GEMINI_MODEL=gemini-3.5-flash-lite
MAX_IMAGE_BYTES=10485760
NODE_ENV=development

# Database is not required for image scanning, but is used by auth/history.
MONGO_URI=mongodb://localhost:27017/nutrilens
JWT_SECRET=replace_with_a_long_random_secret

# Firebase Admin service account file. Keep this file outside git.
FIREBASE_SERVICE_ACCOUNT_PATH=firebase-service-account.json

# Optional fallback if a service-account file is not used.
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-firebase-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY=replace_with_private_key_or_use_service_account_file
FIREBASE_STORAGE_BUCKET=your-firebase-project-id.firebasestorage.app
